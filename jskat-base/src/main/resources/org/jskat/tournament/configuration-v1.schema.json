{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jskat:tournament:configuration:1",
  "title": "JSkat tournament configuration version 1",
  "description": "Shared Java validator additionally enforces normalized UUID/name/input uniqueness, valid filesystem paths and checked schedule-addressability arithmetic.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "ruleset": {
      "const": "standard-skat-v1"
    },
    "seed": {
      "type": "string",
      "pattern": "^0*([0-9]{1,19}|18446744073709551615|0[0-9]{19}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4][0-9]{0})$"
    },
    "epochs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "output": {
      "type": "string",
      "minLength": 1
    },
    "competitors": {
      "type": "array",
      "minItems": 2,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "description": "Trim and NFC-normalize before measuring Unicode code points; normalized names must be unique."
              },
              "implementation": {
                "enum": [
                  "random",
                  "algorithmic"
                ]
              }
            },
            "required": [
              "id",
              "name",
              "implementation"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "description": "Trim and NFC-normalize before measuring Unicode code points; normalized names must be unique."
              },
              "implementation": {
                "enum": [
                  "ml",
                  "ml-pro"
                ]
              },
              "model": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "source": {
                        "const": "active"
                      }
                    },
                    "required": [
                      "source"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "source": {
                        "const": "installed"
                      },
                      "version": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$"
                      }
                    },
                    "required": [
                      "source",
                      "version"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "source": {
                        "const": "development"
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "source",
                      "path"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "id",
              "name",
              "implementation",
              "model"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "ruleset",
    "epochs",
    "output",
    "competitors"
  ],
  "additionalProperties": false
}
